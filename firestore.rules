rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ==========================================
    // Normalized Data Architecture
    // ==========================================
    
    // 1. Private Drafts (Normalized Subcollections & Legacy Events)
    match /users/{uid} {
      allow read, write: if isOwner(uid);
      
      match /invites/{inviteId} {
        allow read, write: if isOwner(uid);
        
        match /pages/{pageId} {
          allow read, write: if isOwner(uid);
          
          match /elements/{elementId} {
            allow read, write: if isOwner(uid);
          }
        }
      }
      
      // Legacy Adapter Path (Read/write mapped or fully manageable by owner)
      match /events/{eventId} {
        allow read, write: if isOwner(uid);
      }
    }

    // 2. Public Projections & Snapshots
    match /public_invites/{inviteId} {
      allow read: if true; 
      allow create: if isSignedIn() && (incoming().ownerId == request.auth.uid || incoming().invite.ownerId == request.auth.uid);
      allow update: if isSignedIn() && (existing().ownerId == request.auth.uid || (existing().invite != null && existing().invite.ownerId == request.auth.uid));
      allow delete: if isSignedIn() && (existing().ownerId == request.auth.uid || (existing().invite != null && existing().invite.ownerId == request.auth.uid));
      
      match /versions/{snapshotId} {
        allow read: if true;
        allow create: if isSignedIn() && (incoming().ownerId == request.auth.uid || incoming().invite.ownerId == request.auth.uid);
        allow update, delete: if false;
      }
      
      match /insights/general {
        allow read: if true;
        allow create, update: if true;
      }

      match /rsvps/{rsvpId} {
        allow read: if true;
        allow create: if incoming().guestName is string && 
                         incoming().guestName.size() > 0 && 
                         incoming().guestName.size() <= 100 &&
                         incoming().attending is bool &&
                         incoming().guestCount is number &&
                         incoming().guestCount >= 0 &&
                         incoming().guestCount <= 50;
        // Only owner can update/delete guest RSVPs
        allow update, delete: if isOwner(get(/databases/$(database)/documents/public_invites/$(inviteId)).data.ownerId);
      }
      
      match /transactions/{txId} {
        allow read: if true;
        allow create: if incoming().senderName is string &&
                         incoming().senderName.size() > 0 &&
                         incoming().senderName.size() <= 100 &&
                         incoming().amount is number &&
                         incoming().amount >= 0;
        allow update, delete: if isOwner(get(/databases/$(database)/documents/public_invites/$(inviteId)).data.ownerId);
      }
    }
    
    // Legacy published path
    match /published_events/{slug} {
      allow read: if true;
      allow write: if isSignedIn();
      
      match /{subPath=**} {
         allow read: if true;
         allow write: if isSignedIn() || true;
      }
    }

    // Connection test document
    match /test/connection {
      allow read, write: if true;
    }
  }
}

